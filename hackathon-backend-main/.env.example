NODE_ENV=development
PORT=5000
# Replica set required. See docker-compose.yml for a local database.
MONGODB_URI=mongodb://127.0.0.1:27017/hcm_lite?replicaSet=rs0&directConnection=true
JWT_SECRET=replace-with-a-random-secret-at-least-32-characters
CORS_ORIGINS=http://localhost:3000,http://localhost:5173
LOG_LEVEL=info
AI_BASE_URL=https://api.openai.com/v1
AI_MODEL=gpt-4o-mini
AI_API_KEY=
# auto uses the local read-only assistant when AI_API_KEY is empty or the provider is unavailable.
AI_FALLBACK_MODE=auto
# Optional explicit CLI bootstrap only (never automatically seeds):
COMPANY_NAME=My Company
ADMIN_EMAIL=
ADMIN_PASSWORD=
